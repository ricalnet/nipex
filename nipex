#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.2"
LOGFILE="${NIPEX_LOG_FILE:-$HOME/.nipex.log}"
LOGGING="${NIPEX_LOG:-0}"
CONF="$HOME/.nipex.conf"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"

if [[ -f "$CONF" ]]; then
    # shellcheck disable=SC1090
    source "$CONF"
fi
NIPE_DIR="${NIPE_DIR:-$SELF_DIR}"
NIPE_PL="$NIPE_DIR/nipe.pl"

R=$'\033[0;31m'; G=$'\033[0;32m'; Y=$'\033[1;33m'
C=$'\033[0;36m'; B=$'\033[1m'; M=$'\033[0;35m'; N=$'\033[0m'

log()  { [[ "$LOGGING" == "1" ]] && echo "$(date '+%F %T') $*" >> "$LOGFILE" || true; }
info() { echo "${C}[i]${N} $*"; log "INFO: $*"; }
ok()   { echo "${G}[✓]${N} $*"; log "OK: $*"; }
warn() { echo "${Y}[!]${N} $*" >&2; log "WARN: $*"; }
err()  { echo "${R}[✗]${N} $*" >&2; log "ERROR: $*"; }

need_root() {
    [[ $EUID -eq 0 ]] && return 0
    warn "Requesting sudo..."
    exec sudo -E "$SELF" "$@"
}

need_dep() {
    command -v "$1" >/dev/null 2>&1 && return 0
    err "Missing dependency: $1  →  sudo apt install $1"
    exit 1
}

have_nipe() {
    [[ -f "$NIPE_PL" ]] && return 0
    err "nipe.pl not found in: $NIPE_DIR"
    err "Run 'nipex install' from the directory containing nipe.pl first."
    exit 1
}

need_pubkey() {
    local name="${1:-id_ed25519}"
    local pub="$HOME/.ssh/$name.pub"
    [[ -f "$pub" ]] || { err "Public key not found: $pub"; exit 1; }
    printf '%s\n' "$pub"
}

SNAPSHOT_DIR="/dev/shm/nipex-session"
SYSTEMD_UNIT="/etc/systemd/system/nipex-privacy-restore.service"

cmd_help() {
    cat << EOF
╔═════════════════════════════════════════════════════════╗
║                    ____    _______                      ║
║                   /    \  |       \                     ║
║                  |  ()  | | PRIVACY!                    ║
║                   \____/  |_______/                     ║
║                                                         ║
║               N I P E   E X T E N D E D                 ║
║              Privacy & Security Toolkit                 ║
║                                                         ║
║         https://git.ricalnet.my.id/rical/nipex/         ║
╚═════════════════════════════════════════════════════════╝

${B}NipeX v${VERSION}${N} - Privacy & Security Toolkit

${B}USAGE${N}:  nipex <command> [args]

${B}LEGEND${N}: ${Y}*${N} = requires sudo    ${M}◦${N} = included in privacy-on

${B}PRIVACY${N}
  ${Y}*${N} privacy-on              Activate privacy mode (checklist + snapshot)
  ${Y}*${N} privacy-off             Restore state now (without reboot)
  ${Y}*${N} privacy-status          Show privacy mode status
  ${Y}*${N} privacy-restore         Internal: called by systemd on reboot
  ${Y}*${N} ${M}◦${N} hostname [name]       Change hostname
  ${Y}*${N} ${M}◦${N} timezone [zone]       Change timezone
  ${Y}*${N} ${M}◦${N} dns                   Set DNS to LibreDNS + Quad9
  ${Y}*${N} mac [iface] [mac]       Random or custom MAC
  ${Y}*${N} ${M}◦${N} mac-all               Randomize all interfaces
  ${Y}*${N} ${M}◦${N} swap-off              Disable swap (session only, non-persistent)
  ${Y}*${N} ${M}◦${N} tmpfs                 Mount /tmp as RAM (tmpfs)
  ${Y}*${N} ${M}◦${N} ipv6-disable          Disable IPv6 (sysctl, non-persistent)
  ${Y}*${N} ipv6-enable             Re-enable IPv6

${B}PRIVACY-EXTRA${N}
    ${M}◦${N} spoof-tz-env [zone]       Show TZ export command for current session
    ${M}◦${N} history-disable           Disable shell history (print instructions)
    strip-meta <file>           Strip metadata from file (exiftool)

${B}CRYPTO${N}
    passwd [len]                Generate strong password (Argon2id hash)
    ssh-key [name]              Generate ed25519 SSH key
    ssh-copy [name]             Copy public key to clipboard
    ssh-add-auth [name]         Add public key to authorized_keys
    ssh-del-auth [name]         Remove public key from authorized_keys
    encrypt <file>              Encrypt file with age (or gpg)
    decrypt <file.age>          Decrypt age file
    encrypt-dir <dir>           Encrypt directory → .tar.age/.tar.gpg
    decrypt-dir <archive>       Decrypt directory archive
    vault-init <vault-dir>      Initialize gocryptfs vault
    vault-mount <vault> [mnt]   Mount gocryptfs vault
    vault-umount <mnt>          Unmount gocryptfs vault
