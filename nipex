}

cmd_version() { echo "NipeX v$VERSION"; }

cmd_install() {
    local dst="/usr/local/bin/nipex"
    [[ "$SELF" == "$dst" ]] && { ok "Already installed at $dst"; return; }
    info "Installing to $dst"
    install -m 0755 "$SELF" "$dst"
    if grep -q '^NIPE_DIR=' "$CONF" 2>/dev/null; then
        info "NIPE_DIR already set in $CONF (not overwriting)"
    else
        echo "NIPE_DIR=\"$SELF_DIR\"" >> "$CONF"
        info "Saved NIPE_DIR to $CONF"
    fi
    ok "Installed."
}

cmd_hostname() {
    local name="${1:-}" cur; cur=$(hostname)
    info "Current hostname: ${B}$cur${N}"
    [[ -z "$name" ]] && read -rp "New hostname: " name
    [[ -z "$name" ]] && { err "Empty hostname."; exit 1; }
    hostnamectl set-hostname "$name"
    ok "Hostname → $name"
}

cmd_timezone() {
    local tz="${1:-}" cur; cur=$(timedatectl show -p Timezone --value)
    info "Current timezone: ${B}$cur${N}"
    if [[ -z "$tz" ]]; then
        if [[ -t 0 ]]; then
            timedatectl list-timezones | less
        fi
        read -rp "New timezone (e.g. Asia/Jakarta): " tz
    fi
    [[ -z "$tz" ]] && { err "Empty timezone."; exit 1; }
    timedatectl set-timezone "$tz" || { err "Invalid timezone: $tz"; exit 1; }
    ok "Timezone → $tz"
}

cmd_dns() {
    info "Setting DNS: 116.202.176.26 (LibreDNS), 9.9.9.9 (Quad9)"
    if command -v resolvectl >/dev/null; then
        local iface; iface=$(ip -o -4 route show default | awk '{print $5; exit}')
        [[ -z "$iface" ]] && { err "No default interface."; exit 1; }
        resolvectl dns "$iface" 116.202.176.26 9.9.9.9
        resolvectl domain "$iface" "~."
        ok "DNS applied on $iface (systemd-resolved)."
    else
        [[ -e /etc/resolv.conf ]] && cp -a /etc/resolv.conf "/etc/resolv.conf.bak.$(date +%s)"
        printf 'nameserver 116.202.176.26\nnameserver 9.9.9.9\n' | tee /etc/resolv.conf >/dev/null
        warn "DNS written to /etc/resolv.conf — may be overwritten by NetworkManager/resolved on reboot."
        ok "DNS applied (/etc/resolv.conf)."
    fi
}

cmd_spoof_tz_env() {
    local tz="${1:-UTC}"

    if [[ ! "$tz" =~ ^[A-Za-z_]+(/[A-Za-z_+-]+)+$ && "$tz" != "UTC" ]]; then
        warn "Unusual timezone format: $tz (e.g. Asia/Jakarta, UTC)"
    fi

    if command -v timedatectl >/dev/null && \
       ! timedatectl list-timezones 2>/dev/null | grep -qx "$tz"; then
        err "Unknown timezone: $tz"
        info "List available: timedatectl list-timezones"
        exit 1
    fi

    export TZ="$tz"
    ok "TZ set to $tz for this shell session."
    echo
    echo "  Current date : $(date)"
    echo "  TZ variable  : ${TZ:-<unset>}"
    echo
    warn "Only applies to this shell — cannot affect the parent shell from a script."
    echo "  Permanent: echo 'export TZ=\"$tz\"' >> ~/.bashrc"
}

cmd_history_disable() {
    info "Disabling shell history for current session..."
    echo
    echo "${B}Copy-paste these commands into your shell:${N}"
    echo
    echo "  ${Y}unset HISTFILE${N}"
    echo "  ${Y}export HISTSIZE=0${N}"
    echo "  ${Y}export HISTFILESIZE=0${N}"
    echo
    info "Or run: source <(nipex history-disable-export)"
    warn "The script cannot affect the parent shell directly."
    echo
    echo "  To re-enable:"
    echo "    export HISTFILE=\"\$HOME/.bash_history\""
    echo "    export HISTSIZE=1000"
    echo "    export HISTFILESIZE=2000"
}

cmd_history_disable_export() {
    cat << 'EOF'
unset HISTFILE
export HISTSIZE=0
export HISTFILESIZE=0
echo "[✓] History disabled for this shell session."
EOF
}

cmd_privacy_on() {
    if [[ -f "$SNAPSHOT_DIR/active" ]]; then
        warn "Privacy mode already active."
        info "Run 'nipex privacy-off' to restore, or reboot."
        exit 1
    fi

    info "Creating snapshot..."
    mkdir -p "$SNAPSHOT_DIR"
    hostname > "$SNAPSHOT_DIR/hostname"
    timedatectl show -p Timezone --value > "$SNAPSHOT_DIR/timezone"
    date +%s > "$SNAPSHOT_DIR/active"

    info "Installing systemd restore unit..."
    cat > "$SYSTEMD_UNIT" << 'EOF'
[Unit]
Description=NipeX privacy session restore
Before=shutdown.target reboot.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nipex privacy-restore

[Install]
WantedBy=shutdown.target
EOF
    systemctl daemon-reload
    systemctl enable nipex-privacy-restore.service >/dev/null 2>&1 || true

    info "Applying privacy changes..."
    local anon_host="DESKTOP-$(tr -dc 'A-Z0-9' < /dev/urandom | head -c 7)"

    echo
    info "[1/11] hostname → $anon_host"
    hostnamectl set-hostname "$anon_host"

    info "[2/11] timezone → UTC"
    timedatectl set-timezone "UTC"

    info "[3/11] dns"
    cmd_dns

    info "[4/11] mac-all"
    cmd_mac_all

    info "[5/11] ipv6-disable"
    cmd_ipv6_disable

    info "[6/11] swap-off"
    cmd_swap_off

    info "[7/11] tmpfs"
    cmd_tmpfs

    echo
    info "[8/11] spoof-tz-env"
    cmd_spoof_tz_env "UTC"

    echo
    info "[9/11] history-disable"
    cmd_history_disable

    echo
    info "[10/11] wipe-history"
    cmd_wipe_history

    echo
    info "[11/11] wipe-log"
    NIPEX_NO_CONFIRM=1 cmd_wipe_log

    echo
    echo "${B}Manual steps required (run in your shell):${N}"
    echo "  1. Disable history : ${Y}source <(nipex history-disable-export)${N}"
    echo "  2. Clear in-memory : ${Y}history -c && history -w${N}"
    echo "  3. Change your IP  : ${Y}nipex start-tor${N}"
    echo "     If it fails     : ${Y}nipex restart-tor${N}"
}

cmd_privacy_off() {
    if [[ ! -f "$SNAPSHOT_DIR/active" ]]; then
        warn "No active privacy mode."
        return
    fi

    info "Restoring state..."

    if [[ -f "$SNAPSHOT_DIR/hostname" ]]; then
        local orig; orig="$(cat "$SNAPSHOT_DIR/hostname")"
        hostnamectl set-hostname "$orig" && ok "Hostname restored: $orig"
    fi

    if [[ -f "$SNAPSHOT_DIR/timezone" ]]; then
        local orig_tz; orig_tz="$(cat "$SNAPSHOT_DIR/timezone")"
        timedatectl set-timezone "$orig_tz" && ok "Timezone restored: $orig_tz"
    fi

    cmd_ipv6_enable

    if systemctl is-enabled nipex-privacy-restore.service >/dev/null 2>&1; then
        systemctl disable nipex-privacy-restore.service >/dev/null 2>&1 || true
        rm -f "$SYSTEMD_UNIT"
        systemctl daemon-reload
        ok "Systemd restore unit removed."
    fi

    rm -rf "$SNAPSHOT_DIR"
    ok "Privacy mode OFF."
}

cmd_privacy_status() {
    if [[ ! -f "$SNAPSHOT_DIR/active" ]]; then
        info "Privacy mode: ${B}INACTIVE${N}"
        return
    fi

    local started
    started=$(cat "$SNAPSHOT_DIR/active")

    ok "Privacy mode: ${B}ACTIVE${N}"
    echo "  Started        : $(date -d "@$started" '+%F %T')"
    echo "  Original host  : $(cat "$SNAPSHOT_DIR/hostname" 2>/dev/null || echo unknown)"
    echo "  Original tz    : $(cat "$SNAPSHOT_DIR/timezone" 2>/dev/null || echo unknown)"
    echo "  Current host   : $(hostname)"
    echo "  Current tz     : $(timedatectl show -p Timezone --value 2>/dev/null || echo unknown)"

    local ipv6_state
    if [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo 0)" == "1" ]]; then
        ipv6_state="disabled"
    else
        ipv6_state="enabled"
    fi
    echo "  IPv6           : $ipv6_state"
    echo
    echo "  Restore now    : nipex privacy-off"
    echo "  Restore on boot: reboot (systemd unit)"
    echo
    echo "${B}Manual steps (if not done yet):${N}"
    echo "  Disable history : ${Y}source <(nipex history-disable-export)${N}"
    echo "  Clear in-memory : ${Y}history -c && history -w${N}"
    echo "  Change your IP  : ${Y}nipex start-tor${N}"
}

cmd_privacy_restore() {
    [[ -f "$SNAPSHOT_DIR/active" ]] || return 0

    [[ -f "$SNAPSHOT_DIR/hostname" ]] && \
        hostnamectl set-hostname "$(cat "$SNAPSHOT_DIR/hostname")" 2>/dev/null || true

    [[ -f "$SNAPSHOT_DIR/timezone" ]] && \
        timedatectl set-timezone "$(cat "$SNAPSHOT_DIR/timezone")" 2>/dev/null || true
}

cmd_strip_meta() {
    local target="${1:-}"
    [[ -z "$target" ]] && { err "Usage: nipex strip-meta <file>"; exit 1; }
    [[ -f "$target" ]] || { err "Not a file: $target"; exit 1; }

    need_dep exiftool

    local bak="$target.bak.$(date +%s)"
    cp -p "$target" "$bak"
    info "Backup: $bak"

    if exiftool -all= -overwrite_original "$target" >/dev/null 2>&1; then
        ok "Metadata stripped: $target"
        local old_size new_size
        old_size=$(stat -c '%s' "$bak")
        new_size=$(stat -c '%s' "$target")
        local saved=$(( old_size - new_size ))
        [[ $saved -gt 0 ]] && info "Saved $saved bytes"
    else
        err "Strip failed — restoring backup."
        mv "$bak" "$target"
        exit 1
    fi
}

cmd_mac() {
    need_dep macchanger
    local iface="${1:-}" mac="${2:-}"
    if [[ -z "$iface" ]]; then
        ip -o link show | awk -F': ' '!/lo/{print $2}' | nl -w2 -s') '
        read -rp "Interface: " iface
    fi
    ip link show "$iface" >/dev/null 2>&1 || { err "No such interface: $iface"; exit 1; }
    if [[ -n "$mac" && ! "$mac" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]; then
        err "Invalid MAC: $mac"; exit 1
    fi
    ip link set "$iface" down
    if [[ -z "$mac" ]]; then macchanger -r "$iface"; else macchanger -m "$mac" "$iface"; fi
    ip link set "$iface" up
    ok "MAC set on $iface."
}

cmd_mac_all() {
    need_dep macchanger
    local ifaces
    ifaces=$(ip -o link show | awk -F': ' '!/lo/{print $2}')
    [[ -z "$ifaces" ]] && { err "No interfaces found."; exit 1; }
    for iface in $ifaces; do
        info "Randomizing $iface..."
        ip link set "$iface" down
        macchanger -r "$iface" >/dev/null
        ip link set "$iface" up
        ok "MAC randomized: $iface"
    done
}

cmd_swap_off() {
    if ! swapon --show | grep -q .; then
        ok "Swap already off."
        return
    fi
    info "Disabling swap (session only)..."
    swapoff -a
    ok "Swap disabled (non-persistent — will return after reboot)."
}

cmd_tmpfs() {
    if mount | grep -q "on /tmp type tmpfs"; then
        ok "/tmp already mounted as tmpfs."
        return
    fi
    info "Mounting /tmp as tmpfs (RAM)..."
    mount -t tmpfs -o size=512M,mode=1777 tmpfs /tmp
    ok "/tmp is now tmpfs (will not survive reboot)."
}

cmd_ipv6_disable() {
    if [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo 0)" == "1" ]]; then
        ok "IPv6 already disabled."
        return
    fi

    info "Disabling IPv6 (session only)..."
    sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null
    sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null
    sysctl -w net.ipv6.conf.lo.disable_ipv6=1 >/dev/null

    ok "IPv6 disabled (non-persistent — will return after reboot)."
    info "Verify: ip -6 addr"
}

cmd_ipv6_enable() {
    if [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo 1)" == "0" ]]; then
        ok "IPv6 already enabled."
        return
    fi

    info "Enabling IPv6..."
    sysctl -w net.ipv6.conf.all.disable_ipv6=0 >/dev/null
    sysctl -w net.ipv6.conf.default.disable_ipv6=0 >/dev/null
    sysctl -w net.ipv6.conf.lo.disable_ipv6=0 >/dev/null

    ok "IPv6 enabled."
    info "Verify: ip -6 addr"
}

cmd_passwd() {
    local len="${1:-20}"
    [[ "$len" =~ ^[0-9]+$ && "$len" -ge 4 && "$len" -le 256 ]] \
        || { err "Length must be 4–256."; exit 1; }

    need_dep argon2

    local pass
    if command -v openssl >/dev/null; then
        pass=$(openssl rand -base64 $(( len * 2 )) | tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' | cut -c1-"$len")
    else
        pass=$(LC_ALL=C head -c $(( len * 4 )) /dev/urandom \
            | LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' | cut -c1-"$len")
    fi

    local salt hash
    if command -v openssl >/dev/null; then
        salt=$(openssl rand -hex 8)
    else
        salt=$(LC_ALL=C head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')
    fi
    hash=$(printf '%s' "$pass" | argon2 "$salt" -id -t 3 -m 16 -p 4 -e)

    echo "${B}Password:${N} $pass"
    echo "${B}Argon2id:${N} $hash"
}

cmd_ssh_key() {
    need_dep ssh-keygen
    local name="${1:-id_ed25519}"
    local key="$HOME/.ssh/$name"
    [[ -f "$key" ]] && { err "Key already exists: $key"; exit 1; }
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    info "Generating ed25519 key at $key..."
    ssh-keygen -t ed25519 -a 100 -f "$key" -C "$name" -N ""
    ok "Key generated."
    echo
    echo "${B}Public key:${N}"
    cat "$key.pub"
}

cmd_ssh_copy() {
    need_dep xclip
    local name="${1:-id_ed25519}"
    local pub; pub="$(need_pubkey "$name")"
    [[ -n "${DISPLAY:-}" ]] || { err "No display found (xclip needs X). Try a local session."; exit 1; }
    xclip -selection clipboard < "$pub"
    ok "Public key copied to clipboard: $name"
}

cmd_ssh_add_auth() {
    local name="${1:-id_ed25519}"
    local pub; pub="$(need_pubkey "$name")"
    local auth="$HOME/.ssh/authorized_keys"
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    touch "$auth"; chmod 600 "$auth"
    if grep -qF "$(cat "$pub")" "$auth" 2>/dev/null; then
        ok "Key already in authorized_keys: $name"
        return
    fi
    cat "$pub" >> "$auth"
    ok "Key added to authorized_keys: $name"
}

cmd_ssh_del_auth() {
    local name="${1:-id_ed25519}"
    local pub; pub="$(need_pubkey "$name")"
    local auth="$HOME/.ssh/authorized_keys"
    [[ -f "$auth" ]] || { err "authorized_keys not found: $auth"; exit 1; }
    local keydata
    keydata=$(cat "$pub")
    if ! grep -qF "$keydata" "$auth"; then
        warn "Key not found in authorized_keys: $name"
        return
    fi
    local tmp; tmp=$(mktemp)
    grep -vF "$keydata" "$auth" > "$tmp"
    mv "$tmp" "$auth"
    chmod 600 "$auth"
    ok "Key removed from authorized_keys: $name"
}

cmd_encrypt() {
    local target="${1:-}"
    [[ -z "$target" ]] && { err "Usage: nipex encrypt <file>"; exit 1; }
    [[ -f "$target" ]] || { err "Not a file: $target"; exit 1; }
    if command -v age >/dev/null; then
        info "Encrypting with age (interactive passphrase)..."
        [[ -e "$target.age" ]] && { err "Already exists: $target.age"; exit 1; }
        age -p -o "$target.age" "$target"
        ok "Encrypted → $target.age"
    elif command -v gpg >/dev/null; then
        info "Encrypting with gpg (AES256)..."
        [[ -e "$target.gpg" ]] && { err "Already exists: $target.gpg"; exit 1; }
        gpg -c --cipher-algo AES256 --yes -o "$target.gpg" "$target"
        ok "Encrypted → $target.gpg"
    else
        err "Need 'age' or 'gpg'. Install: sudo apt install age"
        exit 1
    fi
}

cmd_decrypt() {
    local target="${1:-}"
    [[ -z "$target" ]] && { err "Usage: nipex decrypt <file.age|file.gpg>"; exit 1; }
    [[ -f "$target" ]] || { err "Not found: $target"; exit 1; }
    case "$target" in
        *.age)
            need_dep age
            local out="${target%.age}"
            [[ -e "$out" ]] && { err "Output exists: $out"; exit 1; }
            info "Decrypting age → $out"
            age -d -o "$out" "$target"
            ok "Decrypted → $out"
            ;;
        *.gpg)
            need_dep gpg
            local out="${target%.gpg}"
            [[ -e "$out" ]] && { err "Output exists: $out"; exit 1; }
            info "Decrypting gpg..."
            gpg -d -o "$out" "$target"
            ok "Decrypted → $out"
            ;;
        *) err "Unknown format (need .age or .gpg)"; exit 1 ;;
    esac
}

cmd_encrypt_dir() {
    local target="${1:-}"
    [[ -z "$target" ]] && { err "Usage: nipex encrypt-dir <directory>"; exit 1; }
    [[ -d "$target" ]] || { err "Not a directory: $target"; exit 1; }

    local abs; abs="$(realpath -m "$target")"
    [[ "$abs" == "/" ]] && { err "Refusing to encrypt /"; exit 1; }
    local base; base="$(basename "$abs")"
    local parent; parent="$(dirname "$abs")"

    if command -v age >/dev/null; then
        local out="$abs.tar.age"
        [[ -e "$out" ]] && { err "Already exists: $out"; exit 1; }
        info "Creating archive + encrypting with age..."
        if ! tar -C "$parent" -cf - "$base" | age -p -o "$out" -; then
            rm -f "$out"
            err "Encryption failed — partial output removed."
            exit 1
        fi
        ok "Encrypted → $out"
        echo "  Decrypt with: nipex decrypt-dir $out"
    elif command -v gpg >/dev/null; then
        local out="$abs.tar.gpg"
        [[ -e "$out" ]] && { err "Already exists: $out"; exit 1; }
        info "Creating archive + encrypting with gpg (AES256)..."
        if ! tar -C "$parent" -cf - "$base" | gpg -c --cipher-algo AES256 --yes -o "$out"; then
            rm -f "$out"
            err "Encryption failed — partial output removed."
            exit 1
        fi
        ok "Encrypted → $out"
        echo "  Decrypt with: nipex decrypt-dir $out"
    else
        err "Need 'age' or 'gpg'. Install: sudo apt install age"
        exit 1
    fi
}

cmd_decrypt_dir() {
    local target="${1:-}"
    [[ -z "$target" ]] && { err "Usage: nipex decrypt-dir <archive.tar.age|archive.tar.gpg>"; exit 1; }
    [[ -f "$target" ]] || { err "Not found: $target"; exit 1; }

    local outdir="${2:-.}"
    [[ -d "$outdir" ]] || { err "Output dir not found: $outdir"; exit 1; }

    local abs_out; abs_out="$(realpath -m "$outdir")"
    info "Archive will be extracted to: $abs_out"

    case "$target" in
        *.tar.age)
            need_dep age
            info "Decrypting + extracting age archive..."
            if ! age -d -o - "$target" | tar -C "$abs_out" -xf -; then
                err "Decryption/extraction failed."
                exit 1
            fi
            ok "Extracted to $abs_out"
            ;;
        *.tar.gpg)
            need_dep gpg
            info "Decrypting + extracting gpg archive..."
            if ! gpg -d -o - "$target" | tar -C "$abs_out" -xf -; then
                err "Decryption/extraction failed."
                exit 1
            fi
            ok "Extracted to $abs_out"
            ;;
        *) err "Unknown format (need .tar.age or .tar.gpg)"; exit 1 ;;
    esac
}

cmd_vault_init() {
    local cipher="${1:-}"
    [[ -z "$cipher" ]] && { err "Usage: nipex vault-init <cipher-dir>"; exit 1; }

    need_dep gocryptfs

    local abs; abs="$(realpath -m "$cipher")"
    [[ "$abs" == "/" ]] && { err "Refusing to init vault at /"; exit 1; }

    if [[ -f "$abs/gocryptfs.conf" ]]; then
        err "Vault already initialized: $abs"
        info "Use 'nipex vault-mount $abs <mountpoint>' to mount it."
        exit 1
    fi

    info "Initializing gocryptfs vault at: $abs"
    warn "Save the master key that will be printed — it is the ONLY recovery method if you forget the password."
    echo

    mkdir -p "$abs"
    gocryptfs -init "$abs"

    echo
    ok "Vault initialized: $abs"
    echo "  Encrypted data : $abs"
    echo "  Mount command  : nipex vault-mount $abs /path/to/mountpoint"
}

cmd_vault_mount() {
    local cipher="${1:-}"
    local mountpoint="${2:-}"
    [[ -z "$cipher" ]] && { err "Usage: nipex vault-mount <cipher-dir> [mountpoint]"; exit 1; }

    need_dep gocryptfs

    local abs_cipher; abs_cipher="$(realpath -m "$cipher")"
    [[ -f "$abs_cipher/gocryptfs.conf" ]] || { err "Not a gocryptfs vault: $abs_cipher"; exit 1; }

    if [[ -z "$mountpoint" ]]; then
        mountpoint="${abs_cipher}.open"
        info "No mountpoint given — using default: $mountpoint"
    fi

    local abs_mnt; abs_mnt="$(realpath -m "$mountpoint")"
    mkdir -p "$abs_mnt"

    if mount | grep -q "on $abs_mnt type fuse.gocryptfs"; then
        warn "Already mounted: $abs_mnt"
        return
    fi

    info "Mounting vault..."
    info "  Cipher     : $abs_cipher"
    info "  Mountpoint : $abs_mnt"
    echo

    if gocryptfs "$abs_cipher" "$abs_mnt"; then
        ok "Vault mounted: $abs_mnt"
        echo "  Unmount with: nipex vault-umount $abs_mnt"
    else
        err "Mount failed."
        exit 1
    fi
}

cmd_vault_umount() {
    local mountpoint="${1:-}"
    [[ -z "$mountpoint" ]] && { err "Usage: nipex vault-umount <mountpoint>"; exit 1; }

    local abs_mnt; abs_mnt="$(realpath -m "$mountpoint")"

    if ! mount | grep -q "on $abs_mnt type fuse.gocryptfs"; then
        warn "Not a gocryptfs mountpoint: $abs_mnt"
        return
    fi

    info "Unmounting: $abs_mnt"

    if fusermount -u "$abs_mnt" 2>/dev/null; then
        ok "Vault unmounted: $abs_mnt"
    elif umount "$abs_mnt" 2>/dev/null; then
        ok "Vault unmounted: $abs_mnt"
    else
        err "Failed to unmount. Close any files/terminals inside the mountpoint first."
        exit 1
    fi
}

cmd_vault_status() {
    info "Active gocryptfs mounts:"
    if mount | grep 'type fuse.gocryptfs'; then
        ok "Found mounted vault(s)."
    else
        warn "No gocryptfs vault currently mounted."
    fi
}

cmd_wipe() {
    local target="${1:-}"
    [[ -z "$target" ]] && { err "Usage: nipex wipe <path>"; exit 1; }
    target="$(realpath -m "$target")"
    [[ -e "$target" ]] || { err "Not found: $target"; exit 1; }
    warn "Secure delete: $target"
    warn "NOTE: 'shred' is NOT effective on SSD/NVMe/CoW (btrfs, ZFS)."
    read -rp "Confirm? [y/N] " ans || { warn "Cancelled."; return; }
    [[ "$ans" =~ ^[yY]$ ]] || { warn "Cancelled."; exit 0; }
    if [[ -d "$target" ]]; then
        local skipped
        skipped=$(find "$target" -type f -links +1 2>/dev/null)
        if [[ -n "$skipped" ]]; then
            warn "Skipping hardlinked files (will only be unlinked):"
            echo "$skipped" >&2
        fi
        find "$target" -type f -links 1 -exec shred -uz -n 3 {} \;
        rm -rf "$target"
    else
        if [[ $(stat -c '%h' "$target") -gt 1 ]]; then
            err "Refusing to shred file with hardlinks (data would be lost in all)."
            err "Use 'rm' if you only want to unlink this name."
            exit 1
        fi
        shred -uz -n 3 "$target"
    fi
    ok "Wiped: $target"
}

cmd_wipe_tmp() {
    warn "This will delete files in /tmp and /var/tmp (not sockets/pipes)."
    read -rp "Confirm? [y/N] " ans || { warn "Cancelled."; return; }
    [[ "$ans" =~ ^[yY]$ ]] || { warn "Cancelled."; return; }
    info "Wiping /tmp and /var/tmp..."
    if mount | grep -qE 'on /tmp type tmpfs'; then
        info "/tmp is tmpfs → just rm (shred is pointless in RAM)."
        find /tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
    else
        find /tmp -mindepth 1 -type f -exec shred -uz -n 1 {} \; 2>/dev/null || \
            warn "Some /tmp files could not be wiped."
    fi
    find /var/tmp -mindepth 1 -type f -exec shred -uz -n 1 {} \; 2>/dev/null || true
    ok "Temp wiped (files only)."
}

cmd_wipe_history() {
    info "Wiping shell history files..."
    for f in "$HOME/.bash_history" "$HOME/.zsh_history" "$HOME/.python_history"; do
        [[ -f "$f" ]] && shred -uz -n 3 "$f" 2>/dev/null
    done
    warn "History files removed, BUT the current shell still has history in memory."
    warn "Run this in your shell NOW:  history -c && history -w"
}

cmd_wipe_cache() {
    shopt -s nullglob
    local dirs=("$HOME/.cache" "$HOME/.local/share/Trash")

    # Firefox
    dirs+=("$HOME/.mozilla/firefox"/*/cache2)

    # Chromium-based browsers
    local browser
    for browser in \
        "$HOME/.config/chromium" \
        "$HOME/.config/google-chrome" \
        "$HOME/.config/BraveSoftware/Brave-Browser" \
        "$HOME/.config/BraveSoftware/Brave-Origin"; do
        dirs+=(
            "$browser"/*/Cache
            "$browser"/*/GPUCache
            "$browser"/*/DawnWebGPUCache
            "$browser"/*/DawnGraphiteCache
            "$browser"/*/"Service Worker"/CacheStorage
            "$browser"/*/"Service Worker"/ScriptCache
            "$browser"/*/"Shared Dictionary"/cache
            "$browser"/GPUPersistentCache
            "$browser"/component_crx_cache
            "$browser"/extensions_crx_cache
        )
    done
    shopt -u nullglob

    for d in "${dirs[@]}"; do
        [[ -d "$d" && "$d" == "$HOME"/* ]] || continue
        info "Wiping: $d"
        find "$d" -mindepth 1 -type f -exec shred -uz -n 1 {} \; 2>/dev/null || true
    done
    ok "Caches wiped."
}

cmd_wipe_log() {
    shopt -s nullglob

    local user_files=(
        "$HOME/.xsession-errors"
        "$HOME/.xsession-errors.old"
        "$HOME/.bash_history"
        "$HOME/.zsh_history"
        "$HOME/.python_history"
        "$HOME/.lesshst"
        "$HOME/.viminfo"
        "$HOME/.mysql_history"
        "$HOME/.psql_history"
        "$HOME/.sqlite_history"
        "$HOME/.wget-hsts"
    )

    local user_dirs=(
        "$HOME/.local/share/xorg"
        "$HOME/.cache/logs"
    )

    local zcompdump=("$HOME"/.zcompdump-*)

    shopt -u nullglob

    warn "This will wipe:"
    warn "  - User shell history & editor histories"
    warn "  - wget HSTS cache"
    warn "  - zsh completion cache (.zcompdump-*)"
    warn "  - System logs (/var/log) & systemd journal"
    if [[ "${NIPEX_NO_CONFIRM:-0}" != "1" ]]; then
        read -rp "Confirm? [y/N] " ans || { warn "Cancelled."; return; }
        [[ "$ans" =~ ^[yY]$ ]] || { warn "Cancelled."; return; }
    fi

    info "Wiping user log files..."
    for f in "${user_files[@]}"; do
        [[ -f "$f" ]] || continue
        shred -uz -n 3 "$f" 2>/dev/null && info "Wiped: $f"
    done

    info "Wiping user log directories..."
    for d in "${user_dirs[@]}"; do
        [[ -d "$d" && "$d" == "$HOME"/* ]] || continue
        info "Wiping: $d"
        find "$d" -mindepth 1 -type f -exec shred -uz -n 1 {} \; 2>/dev/null || true
    done

    if [[ ${#zcompdump[@]} -gt 0 ]]; then
        info "Wiping zsh completion cache..."
        for f in "${zcompdump[@]}"; do
            [[ -f "$f" && "$f" == "$HOME"/* ]] || continue
            shred -uz -n 1 "$f" 2>/dev/null && info "Wiped: $f"
        done
    fi

    info "Deleting rotated system logs..."
    find /var/log -mindepth 1 -type f \
        \( -name "*.gz" -o -name "*.old" -o -name "*.[0-9]" \) \
        -delete 2>/dev/null || true

    info "Truncating active system logs..."
    find /var/log -mindepth 1 -type f \
        -name "*.log" \
        -exec truncate -s 0 {} \; 2>/dev/null || \
        warn "Some system log files could not be truncated."

    if [[ -d /var/log/journal ]]; then
        info "Vacuuming systemd journal..."
        journalctl --rotate 2>/dev/null || true
        journalctl --vacuum-time=1s 2>/dev/null || true
        ok "Journal vacuumed."
    fi
    ok "Logs & traces wiped."
}

cmd_fingerprint() {
    need_dep curl
    info "Fetching HTTP fingerprint (what servers see)..."
    echo
    local out
    if out=$(curl -fsS --max-time 10 https://httpbingo.org/headers 2>/dev/null); then
        echo "$out"
    else
        warn "Endpoint httpbingo.org is not reachable."
    fi
    echo
    info "Local timezone: $(timedatectl show -p Timezone --value 2>/dev/null || echo unknown)"
    info "Local locale  : ${LANG:-unknown}"
    info "Hostname      : $(hostname)"
}

cmd_install_tor() {
    have_nipe
    info "Installing cpanminus..."
    apt install -y cpanminus
    info "Installing Nipe dependencies (cpanm --installdeps)..."
    ( cd "$NIPE_DIR" && cpanm --installdeps . )
    info "Running 'perl nipe.pl install'..."
    ( cd "$NIPE_DIR" && perl nipe.pl install )
    ok "Nipe installed."
}

cmd_tor() {
    have_nipe
    ( cd "$NIPE_DIR" && perl nipe.pl "$1" )
}

ROOT_CMDS=(hostname timezone dns mac mac-all swap-off tmpfs
           ipv6-disable ipv6-enable
           wipe-tmp wipe-log
           privacy-on privacy-off privacy-restore
           install install-tor start-tor stop-tor restart-tor status-tor)

main() {
    [[ $# -eq 0 ]] && { cmd_help; exit 0; }
    local cmd="$1"; shift
    for rc in "${ROOT_CMDS[@]}"; do
        [[ "$cmd" == "$rc" ]] && { need_root "$cmd" "$@"; break; }
    done
    case "$cmd" in
        help|-h|--help)       cmd_help ;;
        version|-v|--version) cmd_version ;;
        install)              cmd_install ;;
        hostname)             cmd_hostname "$@" ;;
        timezone)             cmd_timezone "$@" ;;
        dns)                  cmd_dns ;;
        privacy-on)           cmd_privacy_on ;;
        privacy-off)          cmd_privacy_off ;;
        privacy-status)       cmd_privacy_status ;;
        privacy-restore)      cmd_privacy_restore ;;
        spoof-tz-env)         cmd_spoof_tz_env "$@" ;;
        history-disable)      cmd_history_disable ;;
        history-disable-export) cmd_history_disable_export ;;
        strip-meta)           cmd_strip_meta "$@" ;;
        mac)                  cmd_mac "$@" ;;
        mac-all)              cmd_mac_all ;;
        swap-off)             cmd_swap_off ;;
        tmpfs)                cmd_tmpfs ;;
        ipv6-disable)         cmd_ipv6_disable ;;
        ipv6-enable)          cmd_ipv6_enable ;;
        passwd)               cmd_passwd "$@" ;;
        ssh-key)              cmd_ssh_key "$@" ;;
        ssh-copy)             cmd_ssh_copy "$@" ;;
        ssh-add-auth)         cmd_ssh_add_auth "$@" ;;
        ssh-del-auth)         cmd_ssh_del_auth "$@" ;;
        encrypt)              cmd_encrypt "$@" ;;
        decrypt)              cmd_decrypt "$@" ;;
        encrypt-dir)          cmd_encrypt_dir "$@" ;;
        decrypt-dir)          cmd_decrypt_dir "$@" ;;
        vault-init)           cmd_vault_init "$@" ;;
        vault-mount)          cmd_vault_mount "$@" ;;
        vault-umount)         cmd_vault_umount "$@" ;;
        vault-status)         cmd_vault_status ;;
        wipe)                 cmd_wipe "$@" ;;
        wipe-tmp)             cmd_wipe_tmp ;;
        wipe-history)         cmd_wipe_history ;;
        wipe-cache)           cmd_wipe_cache ;;
        wipe-log)             cmd_wipe_log ;;
        fingerprint)          cmd_fingerprint ;;
        install-tor)          cmd_install_tor ;;
        start-tor)            cmd_tor start ;;
        stop-tor)             cmd_tor stop ;;
        restart-tor)          cmd_tor restart ;;
        status-tor)           cmd_tor status ;;
        *) err "Unknown command: '$cmd'"
           err "Run 'nipex help' for usage."; exit 1 ;;
    esac
}

main "$@"